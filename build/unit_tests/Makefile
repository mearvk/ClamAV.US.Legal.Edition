	cd /home/mearvk/CLionProjects/ClamAV.US.Legal.Edition/build && $(MAKE) $(MAKESILENT) -f unit_tests/CMakeFiles/check_clamav.dir/build.make unit_tests/CMakeFiles/check_clamav.dir/check_uniq.c.s
.PHONY : check_uniq.c.s

